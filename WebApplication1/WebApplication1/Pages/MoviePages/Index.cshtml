@page
@model WebApplication1.Pages.MoviePages.IndexModel

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

<p>
    <a class="button" asp-page="Create">Create new movie</a>
</p>
<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Release date</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model.Movies)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.ReleaseDate.ToString("yyyy-MM-dd")</td>
                <td>@movie.Genre</td>
                <td>@movie.Price.ToString("C")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@movie.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@movie.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@movie.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>